description: Internationalization rules (next-intl + Sanity hybrid i18n). Apply when touching routes, links, UI strings, messages or locale logic.
globs: src/app/**,src/i18n/**,src/config/i18n.ts,src/components/**,messages/**,src/lib/i18n/**,src/lib/seo/**
alwaysApply: false
