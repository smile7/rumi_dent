# Copy to .dev.vars for `pnpm preview` (workerd). Never commit .dev.vars.
# In production these are `wrangler secret put <NAME>` (secrets) or wrangler `vars` (plain vars).
NEXTJS_ENV=development

# Secrets
SANITY_API_READ_TOKEN=
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Vars
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
CONTACT_DRY_RUN=true
