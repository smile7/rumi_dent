{
  "name": "site-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm typegen && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm boundaries && pnpm typecheck && pnpm test && pnpm contrast",
    "check:legal": "tsx scripts/check-legal.ts",
    "contrast": "tsx scripts/check-contrast.ts",
    "tokens:export": "tsx scripts/export-brand-colors.ts",
    "boundaries": "tsx scripts/check-boundaries.ts",
    "launch-check": "tsx scripts/launch-check.ts",
    "new-client": "tsx scripts/new-client.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typegen": "sanity schema extract --path schema.json --force && sanity typegen generate",
    "seed": "tsx scripts/seed.ts",
    "smoke:content": "tsx scripts/smoke-content.ts",
    "studio:deploy": "sanity deploy"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hookform/resolvers": "7.0.7",
    "@marsidev/react-turnstile": "1.6.3",
    "@opennextjs/cloudflare": "1.20.17",
    "@portabletext/react": "8.0.1",
    "@sanity/document-internationalization": "6.3.0",
    "@sanity/icons": "5.4.0",
    "@sanity/image-url": "2.2.0",
    "@sanity/orderable-document-list": "2.0.29",
    "@sanity/vision": "6.24.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.76.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "next-intl": "4.15.3",
    "next-sanity": "13.5.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.16",
    "react-hook-form": "7.92.0",
    "resend": "6.39.0",
    "sanity": "6.24.0",
    "sanity-plugin-internationalized-array": "5.3.10",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "styled-components": "6.6.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@clack/prompts": "1.9.0",
    "@sanity/client": "8.17.0",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "schema-dts": "2.1.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  }
}
