# Copy to .env.local for `pnpm dev`. Never commit real values.
# Runtime secrets for `pnpm preview` (workerd) go in .dev.vars instead (see .dev.vars.example).
# Validated by src/env.ts (public) and src/env.server.ts (server). See docs/ARCHITECTURE.md §9.

# --- Site (required at build) ---------------------------------------------
# Canonical origin, no trailing slash. Defaults to http://localhost:3000 in `next dev`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# production | preview | development (controls robots/noindex)
NEXT_PUBLIC_ENV=development
# Show /styleguide (true on preview, false in production after sign-off)
NEXT_PUBLIC_ENABLE_STYLEGUIDE=true

# --- Sanity (public; required from Phase 03) -------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
# production | development
NEXT_PUBLIC_SANITY_DATASET=development
# /admin (embedded) or https://<client>.sanity.studio
NEXT_PUBLIC_SANITY_STUDIO_URL=/admin

# --- Sanity (server secrets) -----------------------------------------------
# Viewer token: draft mode + seed reads
SANITY_API_READ_TOKEN=
# Local only (seed). Never deployed to the Worker or stored in CI.
SANITY_WRITE_TOKEN=

# --- Contact form ------------------------------------------------------------
# Turnstile test keys (always pass) are used automatically in `next dev` when empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
RESEND_API_KEY=
# e.g. Website <noreply@mail.client.bg>
CONTACT_FROM_EMAIL=
# Optional: overrides siteSettings.contactForm.recipient
CONTACT_TO_EMAIL=
# true skips the Resend call (local testing only; never in production)
CONTACT_DRY_RUN=true

# --- Analytics (public) -----------------------------------------------------
# none | cloudflare | umami | ga4
NEXT_PUBLIC_ANALYTICS=none
NEXT_PUBLIC_CF_BEACON_TOKEN=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_GA_ID=

# --- Deploys (CI only, GitHub secrets) --------------------------------------
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
